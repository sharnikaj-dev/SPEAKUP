# SPEAKUP Application Configuration
# Copy this file to .env and adjust values for your local environment

# Flask secret key for signing session cookies (use a random secure string in production)
SECRET_KEY=speakup_dev_secret_key_change_me_in_production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=speakup
